{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
      "aeconfiguraciones": {
        "root": "",
        "sourceRoot": "src",
        "projectType": "application",
        "prefix": "aeconfiguraciones",
        "schematics": {},
        "architect": {
          "build": {
            "builder": "@angular-builders/custom-webpack:browser",
            "options": {
              "outputPath": "dist",
              "index": "src/index.html",
              "main": "src/main.single-spa.ts",
              "polyfills": "src/polyfills.ts",
              "tsConfig": "src/tsconfig.app.json",
              "sourceMap": true,
              "assets": [
                "src/favicon.ico",
                "src/assets",
                {
                  "glob": "**/*",
                  "input": "node_modules/ngx-extended-pdf-viewer/assets/",
                  "output": "/assets/"
                }
              ],
              "styles": [
                "./node_modules/bootstrap/dist/css/bootstrap.min.css",
                "./node_modules/primeng/resources/themes/nova/theme.css",
                "./node_modules/primeng/resources/primeng.min.css",
                "./node_modules/primeicons/primeicons.css",
                "./node_modules/quill/dist/quill.core.css", 
                "./node_modules/quill/dist/quill.snow.css",
                "./src/styles.css"
              ],
              "scripts": [
                "./node_modules/jquery/dist/jquery.min.js",
                "./node_modules/bootstrap/dist/js/bootstrap.bundle.js",
                "./node_modules/chart.js/dist/Chart.js",
                "./node_modules/quill/dist/quill.js"
              ],
              "customWebpackConfig": {
                "path": "extra-webpack.config.js",
                "libraryName": "aeconfiguraciones",
                "libraryTarget": "system"
              }
            },
            "configurations": {
              "production": {
                "fileReplacements": [
                  {
                    "replace": "src/environments/environment.ts",
                    "with": "src/environments/environment.prod.ts"
                  }
                ],
                "optimization": true,
                "outputHashing": "all",
                "sourceMap": false,
                "namedChunks": false,
                "aot": true,
                "extractLicenses": true,
                "vendorChunk": false,
                "buildOptimizer": true,
                "budgets": [
                  {
                    "type": "initial",
                    "maximumWarning": "2mb",
                    "maximumError": "10mb"
                  }
                ]
              },
              "standalone": {
                "fileReplacements": [
                  {
                    "replace": "src/environments/environment.ts",
                    "with": "src/environments/environment.standalone.ts"
                  }
                ],
                "customWebpackConfig": {
                  "path": "extra-webpack.config.standalone.js"
                },
                "main": "src/main.ts",
                "tsConfig": "src/tsconfig.app.standalone.json"
              }
            }
          },
          "serve": {
            "builder": "@angular-builders/custom-webpack:dev-server",
            "options": {
              "browserTarget": "aeconfiguraciones:build"
            },
            "configurations": {
              "production": {
                "browserTarget": "aeconfiguraciones:build:production"
              },
              "standalone": {
                "browserTarget": "aeconfiguraciones:build:standalone"
              }
            }
          },
          "extract-i18n": {
            "builder": "@angular-devkit/build-angular:extract-i18n",
            "options": {
              "browserTarget": "aeconfiguraciones:build"
            }
          },
          "test": {
            "builder": "@angular-devkit/build-angular:karma",
            "options": {
              "main": "src/test.ts",
              "polyfills": "src/polyfills.ts",
              "tsConfig": "src/tsconfig.spec.json",
              "karmaConfig": "src/karma.conf.js",
              "styles": [
                "src/styles.css"
              ],
              "scripts": [],
              "assets": [
                "src/favicon.ico",
                "src/assets"
              ]
            }
          },
          "lint": {
            "builder": "@angular-devkit/build-angular:tslint",
            "options": {
              "tsConfig": [
                "src/tsconfig.app.json",
                "src/tsconfig.spec.json"
              ],
              "exclude": [
                "**/node_modules/**"
              ]
            }
          }
        }
      }
    }
  }
  
